---
interface Props { id: string; label?: string; }
const { id, label = 'Đánh dấu đã học xong' } = Astro.props;
---
<div class="complete-module" data-module={id}>
  <div class="complete-module__text">
    <strong>Hoàn thành module này?</strong>
    <span class="complete-module__hint">Tiến độ được lưu trong trình duyệt này.</span>
  </div>
  <button type="button" data-module-done={id} data-label={label}>{label}</button>
</div>
