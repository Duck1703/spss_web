---
// Landing page — không dùng Starlight template (cần hero + progress UI tùy ý).
import '../styles/tokens.css';

const days = [
  { slug: 'd01', code: 'Ngày 01', title: 'Mở file bài tập & đọc dữ liệu — P1-Q01', ready: true },
  { slug: 'd02', code: 'Ngày 02', title: 'Tần số và phần trăm — P1-Q02, P1-Q38', ready: true },
  { slug: 'd03', code: 'Ngày 03', title: 'Thống kê mô tả biến số — P1-Q03, P1-Q04', ready: true },
  { slug: 'd04', code: 'Ngày 04', title: 'Tóm tắt theo nhóm — Select Cases · Split File' },
  { slug: 'd05', code: 'Ngày 05', title: 'Bảng chéo và Chi-square' },
  { slug: 'd06', code: 'Ngày 06', title: 'Biến đổi dữ liệu — Compute · Recode · Count' },
  { slug: 'd07', code: 'Ngày 07', title: 'Soi và xử lý dữ liệu nhập sai' },
  { slug: 'd08', code: 'Ngày 08', title: 'Kiểm định về tỷ lệ' },
  { slug: 'd09', code: 'Ngày 09', title: 'So sánh trung bình — 1 mẫu & 2 nhóm' },
  { slug: 'd10', code: 'Ngày 10', title: 'T-test ghép cặp và ANOVA' },
  { slug: 'd11', code: 'Ngày 11', title: 'Tương quan và hồi quy tuyến tính' },
  { slug: 'd12', code: 'Ngày 12', title: 'Capstone A — khám phá & chuẩn bị File5' },
  { slug: 'd13', code: 'Ngày 13', title: 'Capstone B — phân tích & báo cáo File5' },
  { slug: 'd14', code: 'Ngày 14', title: 'Đánh giá thực hành cuối khóa' },
];
const references = [
  { href: '/m01/bai-hoc/', code: 'M01', title: 'Tư duy nghiên cứu y khoa & ngôn ngữ thống kê', week: 'Tham khảo' },
  { href: '/lo-trinh/', code: '16w', title: 'Lộ trình 16 tuần — Blueprint gốc (không phải lộ trình hiện tại)', week: 'Tham khảo' },
];
const extensions = [
  { code: 'E01', title: 'Chẩn đoán: sensitivity, specificity, ROC/AUC' },
  { code: 'E02', title: 'Kaplan–Meier, log-rank, Cox' },
  { code: 'E03', title: 'Missing data, complex survey, multiple testing' },
];
const outcomes = [
  'Mở file .sav bài tập nguồn, đọc Variable View, codebook và nhãn giá trị.',
  'Chạy Frequencies/Descriptives và đọc đúng các cột output.',
  'Tóm tắt theo nhóm: Select Cases, Split File, Crosstabs và Chi-square.',
  'Biến đổi dữ liệu: Compute (BMI), Recode nhóm, đếm đa biến; soi lỗi nhập liệu.',
  'So sánh trung bình và tỷ lệ: t-test các loại, ANOVA, chi-square, binomial.',
  'Phân tích một dataset mới từ đầu đến báo cáo (Capstone File5).',
];
const howTo = [
  { title: 'Bài tập trước, lý thuyết sau', text: 'Mỗi ngày mở bằng một bài tập gốc (P1-Q01…P2-Q15) — học chỉ đủ để giải nó.' },
  { title: 'Học theo thứ tự ngày', text: 'Bài sau dùng lại file và kỹ năng bài trước — đừng nhảy cóc.' },
  { title: 'Mở SPSS ngay', text: '80% thời lượng mỗi ngày là thao tác thật — đọc lý thuyết đúng lúc cần.' },
  { title: 'Dataset nguồn ở local', text: 'File .sav bài tập nằm trong exercises/ trên máy — mở trực tiếp, không tải từ web.' },
];
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SPSS Medical Learning Pack — Học thống kê y khoa bằng tiếng Việt</title>
  <meta name="description" content="Khóa tự học SPSS và thống kê y khoa cho người chưa có nền tảng — tiếng Việt, từng bước, trên MacBook." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('starlight-theme'); } catch (e) {}
      var theme = stored === 'light' || stored === 'dark'
        ? stored
        : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme;
      window.__slpThemeMode = stored === 'light' || stored === 'dark' ? stored : 'auto';
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" />
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: var(--slp-font-body);
      background: var(--slp-bg);
      color: var(--slp-text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--slp-accent-strong); }
    ::selection { background: var(--slp-accent-soft-2); }
    :focus-visible { outline: 2px solid var(--slp-accent); outline-offset: 2px; }

    .wrap { max-width: var(--slp-wide-width); margin: 0 auto; padding: 0 24px; }

    /* Top nav */
    .topnav {
      position: sticky; top: 0; z-index: 10;
      background: color-mix(in srgb, var(--slp-bg) 82%, transparent);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--slp-border);
    }
    .topnav__inner { display: flex; align-items: center; gap: 16px; height: 64px; }
    .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--slp-text); font-weight: 700; letter-spacing: -0.01em; }
    .brand svg { border-radius: 7px; display: block; }
    .topnav__links { margin-left: auto; display: flex; align-items: center; gap: 4px; }
    .topnav__links a {
      text-decoration: none; color: var(--slp-text-2); font-size: var(--slp-text-small);
      font-weight: 500; padding: 8px 12px; border-radius: var(--slp-radius-md);
      transition: background var(--slp-motion-fast) var(--slp-ease), color var(--slp-motion-fast) var(--slp-ease);
    }
    .topnav__links a:hover { background: var(--slp-surface-2); color: var(--slp-text); }
    .theme-toggle {
      font: inherit; cursor: pointer; border: 1px solid var(--slp-border);
      background: var(--slp-surface); color: var(--slp-text-2);
      width: 36px; height: 36px; border-radius: var(--slp-radius-full);
      display: inline-flex; align-items: center; justify-content: center;
      transition: border-color var(--slp-motion-fast) var(--slp-ease), color var(--slp-motion-fast) var(--slp-ease);
    }
    .theme-toggle:hover { border-color: var(--slp-accent); color: var(--slp-accent-strong); }
    .theme-toggle .icon-sun { display: none; }
    [data-theme='dark'] .theme-toggle .icon-sun { display: block; }
    [data-theme='dark'] .theme-toggle .icon-moon { display: none; }

    /* Hero */
    .hero { padding: var(--slp-space-12) 0 var(--slp-space-10); max-width: 56rem; }
    .kicker {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: var(--slp-text-caption); font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--slp-accent-strong);
      background: var(--slp-accent-soft); border-radius: var(--slp-radius-full);
      padding: 6px 14px;
    }
    h1 {
      font-size: clamp(2.1rem, 5vw, 3.1rem); line-height: 1.2; letter-spacing: -0.02em;
      font-weight: 700; margin: 20px 0 0; max-width: 20ch;
    }
    .lead { font-size: 1.15rem; color: var(--slp-text-2); max-width: 56ch; margin: 18px 0 0; }
    .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 13px 24px; border-radius: var(--slp-radius-full);
      font-weight: 600; font-size: 0.95rem; text-decoration: none;
      border: 1px solid var(--slp-border); background: var(--slp-surface); color: var(--slp-text);
      transition: border-color var(--slp-motion-fast) var(--slp-ease),
        box-shadow var(--slp-motion-fast) var(--slp-ease),
        transform var(--slp-motion-fast) var(--slp-ease);
    }
    .btn:hover { border-color: var(--slp-border-strong); box-shadow: var(--slp-shadow-md); transform: translateY(-1px); }
    .btn-primary { background: var(--slp-accent); border-color: var(--slp-accent); color: var(--slp-on-accent); }
    .btn-primary:hover { border-color: var(--slp-accent-strong); box-shadow: var(--slp-shadow-md); }
    .btn-accent-ghost { border-color: var(--slp-accent); color: var(--slp-accent-strong); background: transparent; }
    .btn-accent-ghost:hover { background: var(--slp-accent-soft); }
    .btn-small { padding: 8px 16px; font-size: var(--slp-text-small); }
    .hero__meta { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--slp-border); }
    .hero__meta div { font-size: var(--slp-text-small); color: var(--slp-muted); }
    .hero__meta strong { display: block; font-size: 1.05rem; color: var(--slp-text); font-weight: 700; }

    /* Sections */
    section { margin-top: var(--slp-space-12); }
    .section-head { max-width: 44rem; margin-bottom: var(--slp-space-6); }
    .section-head .eyebrow { font-size: var(--slp-text-caption); font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: var(--slp-accent-strong); }
    .section-head h2 { font-size: var(--slp-text-h2); font-weight: 700; letter-spacing: -0.01em; line-height: 1.3; margin: 8px 0 0; }
    .section-head p { color: var(--slp-text-2); margin: 12px 0 0; }

    /* Progress panel */
    .progress-panel {
      background: var(--slp-surface); border: 1px solid var(--slp-border);
      border-radius: var(--slp-radius-xl); padding: var(--slp-space-5) var(--slp-space-6);
      box-shadow: var(--slp-shadow-md);
      display: flex; flex-direction: column; gap: 14px;
    }
    .progress-panel__row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .progress-panel__title { font-weight: 700; font-size: 1.05rem; }
    .progress-panel__count { font-size: var(--slp-text-small); color: var(--slp-text-2); }
    .progress-bar { height: 8px; border-radius: var(--slp-radius-full); background: var(--slp-surface-2); overflow: hidden; }
    .progress-bar__fill { height: 100%; width: 0%; border-radius: inherit; background: var(--slp-accent); transition: width 400ms var(--slp-ease); }
    .progress-panel__actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .progress-panel__note { font-size: var(--slp-text-small); color: var(--slp-muted); margin: 0; }

    /* Cards */
    .cards { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
    .cards--compact { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
    .card {
      background: var(--slp-surface); border: 1px solid var(--slp-border);
      border-radius: var(--slp-radius-lg); padding: 18px 20px;
      display: flex; flex-direction: column; gap: 8px;
      box-shadow: var(--slp-shadow-sm);
    }
    .card__top { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
    .card__code { font-family: var(--slp-font-mono); font-size: var(--slp-text-caption); font-weight: 700; letter-spacing: 0.06em; color: var(--slp-accent-strong); }
    .card__week { font-size: var(--slp-text-caption); color: var(--slp-muted); }
    .card__title { font-weight: 600; font-size: 0.98rem; line-height: 1.45; }
    .card__title a { color: inherit; text-decoration: none; }
    .card__title a:hover { color: var(--slp-accent-strong); }
    .card--muted { background: var(--slp-surface); }
    .card--muted .card__code { color: var(--slp-muted); }
    .card--muted .card__title { color: var(--slp-text-2); }

    .pill {
      align-self: flex-start;
      font-size: var(--slp-text-caption); font-weight: 600; letter-spacing: 0.05em;
      padding: 4px 12px; border-radius: var(--slp-radius-full);
      background: var(--slp-surface-2); color: var(--slp-muted); border: 1px solid var(--slp-border);
    }
    .pill--ready { background: var(--slp-success-soft); color: var(--slp-success-strong); border-color: transparent; }

    /* Featured module */
    .module-feature {
      grid-column: 1 / -1;
      background: var(--slp-surface);
      border: 1px solid var(--slp-accent);
      border-radius: var(--slp-radius-xl);
      padding: var(--slp-space-6) var(--slp-space-6);
      display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: center;
      box-shadow: var(--slp-shadow-md);
      position: relative; overflow: hidden;
    }
    .module-feature::before {
      content: ''; position: absolute; inset: 0 auto 0 0; width: 5px;
      background: var(--slp-accent);
    }
    .module-feature .card__code { font-size: var(--slp-text-small); }
    .module-feature h3 { font-size: var(--slp-text-h3); font-weight: 700; letter-spacing: -0.01em; margin: 6px 0 0; line-height: 1.3; }
    .module-feature p { color: var(--slp-text-2); font-size: 0.95rem; margin: 10px 0 0; max-width: 52ch; }
    .module-feature__badges { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; align-items: center; }
    .module-feature__actions { display: flex; flex-direction: column; gap: 10px; }
    @media (max-width: 48rem) {
      .module-feature { grid-template-columns: 1fr; }
      .module-feature__actions { flex-direction: row; flex-wrap: wrap; }
    }

    /* Outcomes */
    .outcomes { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
    .outcome {
      display: flex; gap: 14px; padding: 18px 20px;
      background: var(--slp-surface); border: 1px solid var(--slp-border);
      border-radius: var(--slp-radius-lg); box-shadow: var(--slp-shadow-sm);
    }
    .outcome__num {
      flex-shrink: 0; width: 28px; height: 28px; border-radius: var(--slp-radius-full);
      background: var(--slp-accent-soft); color: var(--slp-accent-strong);
      font-size: var(--slp-text-small); font-weight: 700;
      display: inline-flex; align-items: center; justify-content: center;
    }
    .outcome p { margin: 0; font-size: 0.95rem; color: var(--slp-text-2); }

    /* How to study */
    .steps { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); counter-reset: step; }
    .step {
      padding: 18px 20px; border-radius: var(--slp-radius-lg);
      background: var(--slp-bg-soft); border: 1px solid var(--slp-border);
    }
    .step::before {
      counter-increment: step; content: counter(step, decimal-leading-zero);
      font-family: var(--slp-font-mono); font-size: var(--slp-text-caption);
      font-weight: 700; color: var(--slp-accent-strong); letter-spacing: 0.08em;
    }
    .step strong { display: block; margin-top: 10px; font-size: 0.98rem; }
    .step span { display: block; margin-top: 4px; font-size: var(--slp-text-small); color: var(--slp-text-2); }

    footer.site-footer {
      margin-top: var(--slp-space-12);
      padding: var(--slp-space-6) 0;
      border-top: 1px solid var(--slp-border);
      color: var(--slp-muted); font-size: var(--slp-text-small);
    }

    @media (max-width: 48rem) {
      .hero { padding: var(--slp-space-8) 0 var(--slp-space-8); }
      section { margin-top: var(--slp-space-8); }
      .topnav__links a { padding: 8px 9px; }
    }
    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }
  </style>
</head>
<body>
  <nav class="topnav">
    <div class="wrap topnav__inner">
      <a class="brand" href="/">
        <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="#4F46E5"/>
          <rect x="7.5" y="18.5" width="4" height="7" rx="1.4" fill="#fff" opacity="0.85"/>
          <rect x="14" y="13.5" width="4" height="12" rx="1.4" fill="#fff" opacity="0.92"/>
          <rect x="20.5" y="8.5" width="4" height="17" rx="1.4" fill="#fff"/>
        </svg>
        <span>SPSS Medical Learning Pack</span>
      </a>
      <div class="topnav__links">
        <a href="/lo-trinh-14-ngay/">Lộ trình 14 ngày</a>
        <a href="/du-lieu/">Dữ liệu</a>
        <a href="/tai-lieu/thuat-ngu/">Tài liệu</a>
        <button class="theme-toggle" type="button" aria-label="Chuyển giao diện sáng/tối" data-theme-toggle>
          <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
          <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="4.4" stroke="currentColor" stroke-width="1.8"/>
            <path d="M12 2v2.2M12 19.8V22M2 12h2.2M19.8 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div class="wrap">
    <header class="hero">
      <span class="kicker">Khóa tự học · 14 ngày · exercise-first</span>
      <h1>Học SPSS qua bài tập thật — 14 ngày, tiếng Việt.</h1>
      <p class="lead">
        Dành cho người <strong>chưa từng dùng SPSS</strong> và <strong>gần như chưa học thống kê</strong>.
        Mỗi ngày mở bằng một <strong>bài tập gốc</strong> từ đề thực hành (P1-Q01…P2-Q15) —
        bạn giải bài thật trên dataset thật, lý thuyết chỉ xuất hiện khi bài đòi hỏi.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="/d01/bai-hoc/">Bắt đầu — Ngày 01</a>
        <a class="btn btn-accent-ghost" data-continue hidden href="#">Tiếp tục học →</a>
        <a class="btn" href="/lo-trinh-14-ngay/">Xem lộ trình 14 ngày</a>
        <a class="btn" href="/du-lieu/">Tải dữ liệu</a>
      </div>
      <div class="hero__meta">
        <div><strong>58 bài tập</strong>nguồn, gắn ID P1-Q01…P2-Q15</div>
        <div><strong>90–120 phút</strong>mỗi ngày, 80% thực hành</div>
        <div><strong>Ngày 01–03</strong>sẵn sàng · 04–14 đang DRAFT</div>
      </div>
    </header>

    <section aria-label="Tiến độ">
      <div class="progress-panel">
        <div class="progress-panel__row">
          <span class="progress-panel__title">Tiến độ của bạn</span>
          <span class="progress-panel__count" data-progress-count>Chưa có dữ liệu</span>
        </div>
        <div class="progress-bar" role="progressbar" aria-label="Tiến độ bài tập" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar__fill" data-progress-fill></div>
        </div>
        <div class="progress-panel__actions">
          <button class="btn btn-small" type="button" onclick="slpExport()">Xuất tiến độ (JSON)</button>
          <label class="btn btn-small">Nhập tiến độ
            <input type="file" accept=".json" hidden onchange="slpImport(this.files[0])" />
          </label>
        </div>
        <p class="progress-panel__note">
          Tiến độ lưu trên <strong>trình duyệt này</strong> — có thể mất khi xóa dữ liệu trình duyệt
          và không tự đồng bộ sang thiết bị khác.
        </p>
      </div>
    </section>

    <section>
      <div class="section-head">
        <span class="eyebrow">Kết quả học tập</span>
        <h2>Sau khóa học bạn làm được gì?</h2>
        <p>Dành cho người làm y tế, sinh viên — muốn tự phân tích dữ liệu nghiên cứu, <em>không cần</em> nền thống kê hay lập trình.</p>
      </div>
      <div class="outcomes">
        {outcomes.map((o, i) => (
          <div class="outcome"><span class="outcome__num">{i + 1}</span><p>{o}</p></div>
        ))}
      </div>
    </section>

    <section>
      <div class="section-head">
        <span class="eyebrow">Chương trình học</span>
        <h2>Lộ trình 14 ngày — exercise-first</h2>
        <p>Mỗi ngày mở bằng bài tập nguồn thật. Ngày 01–03 đã hoàn thiện; Ngày 04–14 đã ánh xạ bài tập và đang được xây dựng tiếp.</p>
      </div>
      <div class="cards cards--compact">
        {days.map((d) => (
          <div class="card">
            <div class="card__top">
              <span class="card__code">{d.code}</span>
              <span class="pill" data-module-badge={d.slug}></span>
            </div>
            <span class="card__title"><a href={`/${d.slug}/bai-hoc/`}>{d.title}</a></span>
            <span class={`pill${d.ready ? ' pill--ready' : ''}`}>{d.ready ? 'Đã có bài học' : 'DRAFT — đang xây dựng'}</span>
          </div>
        ))}
      </div>
    </section>

    <section>
      <div class="section-head">
        <span class="eyebrow">Tham khảo</span>
        <h2>Chương trình 16 tuần — bản Blueprint gốc</h2>
        <p>Giữ làm tài liệu tham khảo dài hạn. Khi có thêm thời gian, quay lại học sâu phần tư duy nghiên cứu.</p>
      </div>
      <div class="cards cards--compact">
        {references.map((r) => (
          <div class="card">
            <div class="card__top">
              <span class="card__code">{r.code}</span>
              <span class="card__week">{r.week}</span>
            </div>
            <span class="card__title"><a href={r.href}>{r.title}</a></span>
            {r.code === 'M01' && <span class="pill" data-module-badge="m01"></span>}
          </div>
        ))}
        {extensions.map((e) => (
          <div class="card card--muted">
            <div class="card__top"><span class="card__code">{e.code}</span></div>
            <span class="card__title">{e.title}</span>
            <span class="pill">Đang biên soạn</span>
          </div>
        ))}
      </div>
    </section>

    <section>
      <div class="section-head">
        <span class="eyebrow">Cách học hiệu quả</span>
        <h2>Bốn nguyên tắc khi tự học</h2>
      </div>
      <div class="steps">
        {howTo.map((s) => (
          <div class="step"><strong>{s.title}</strong><span>{s.text}</span></div>
        ))}
      </div>
    </section>

    <footer class="site-footer">
      SPSS Medical Learning Pack · Lộ trình exercise-first 14 ngày (Task 13 / D-024) ·
      Website build từ giáo trình Markdown canonical · dataset nguồn trong exercises/ chỉ dùng local.
    </footer>
  </div>

  <script src="/js/progress.js" defer></script>
  <script is:inline>
    (function () {
      var btn = document.querySelector('[data-theme-toggle]');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('starlight-theme', next); } catch (e) {}
      });
    })();
  </script>
</body>
</html>
