---
// Dashboard — Clinical Editorial B v2 (approved prototype: screens/dashboard-b-v2.html).
// Standalone page (không qua Starlight): worktop + roadmap 4 chặng + lower cards.
// Metadata ngày đọc từ src/data/course-meta.json (single source, sinh bởi sync-content.mjs).
// Tiến độ THẬT do public/js/progress.js điền — không hardcode, không dùng key prototype.
import '../styles/tokens.css';
import '../styles/custom.css';
import Bv2Nav from '../components/Bv2Nav.astro';
import meta from '../data/course-meta.json';

const days = meta.stages.flatMap((name, si) =>
  Object.values(meta.days).filter((d) => d.stage === si + 1).map((d) => ({ ...d, stageName: name })),
);
const chapters = meta.stages.map((name, si) => ({
  symbol: `0${si + 1}`,
  name,
  sub: [
    'Đọc file .sav, tần số, thống kê mô tả',
    'Bảng chéo, biến đổi biến, làm sạch dữ liệu',
    'Kiểm định tỷ lệ, t-test, ANOVA, tương quan & hồi quy',
    'Capstone trên File5 và đánh giá cuối khóa',
  ][si],
  days: days.filter((d) => d.stage === si + 1),
}));
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SPSS Medical — Khóa tự học SPSS & thống kê y khoa</title>
  <meta name="description" content="Khóa tự học SPSS và thống kê y khoa cho người chưa có nền tảng — tiếng Việt, từng bước, 14 ngày trên dataset thật." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" />
</head>
<body class="dash">
  <header class="header"><Bv2Nav active="home" /></header>

  <main class="main">
    <div class="pageheading">
      <div>
        <div class="eyebrow">KHÓA TỰ HỌC · 14 NGÀY · DATASET THẬT</div>
        <h1>Học SPSS qua bài tập thống kê y khoa</h1>
        <p class="subtext">Mỗi ngày mở bằng một bài tập gốc từ hai bộ đề thực hành — học đúng phần lý thuyết cần để giải, rồi làm trên SPSS thật. 90–120 phút một ngày.</p>
      </div>
    </div>

    <div class="worktop">
      <section class="continue-card" aria-label="Bài học tiếp theo">
        <div class="continue-content">
          <span class="tiny-label"><span class="dot"></span><span data-dash-next-chip>NGÀY 01 / 14 — TIẾP THEO CỦA BẠN</span></span>
          <h2 data-dash-next-title>Mở file bài tập &amp; đọc dữ liệu</h2>
          <p class="desc" data-dash-next-meta>Bài tập hôm nay: P1-Q01 · Dataset: p1_B01_HA (1).sav</p>
          <div class="metarow">
            <span>Bài tập trước — lý thuyết sau</span>
            <span>Hướng dẫn mô phỏng SPSS từng bước</span>
            <span>Mac &amp; Windows</span>
          </div>
          <div class="continue-actions">
            <a class="btn primary" href="/d01/bai-hoc/" data-dash-next-href>Bắt đầu — Ngày 01</a>
            <a class="secondary-link" data-continue hidden href="#">↩ Quay lại trang đang đọc gần nhất</a>
          </div>
        </div>
      </section>

      <section class="progress-card" id="tien-do" aria-label="Tiến độ học">
        <div class="headrow">
          <span class="tiny-label"><span class="dot"></span>TIẾN ĐỘ CỦA BẠN</span>
          <span class="pct" data-progress-count>Chưa có dữ liệu</span>
        </div>
        <div class="big"><strong data-dash-days>—</strong><span>/ 14 ngày đã hoàn thành</span></div>
        <div class="bar" role="progressbar" aria-label="Phần trăm hoàn thành lộ trình" aria-valuemin="0" aria-valuemax="100">
          <span data-progress-fill style="width:0%"></span>
        </div>
        <div class="statrows">
          <div><strong data-dash-ex>—</strong><span>/ 58 bài tập nguồn đã làm</span></div>
          <div><strong data-dash-remain>—</strong><span>bài tập còn lại</span></div>
        </div>
      </section>
    </div>

    <div class="sectionhead" id="lo-trinh">
      <div>
        <h2>Lộ trình 14 ngày</h2>
        <p>Bốn chặng từ đọc dữ liệu đến capstone — bài sau dùng lại kỹ năng bài trước.</p>
      </div>
      <div class="sectiontools" role="navigation" aria-label="Nhảy tới chặng">
        {chapters.map((c, i) => (
          <a class="seg" href={`#ch-${i + 1}`}>Chặng {i + 1}</a>
        ))}
      </div>
    </div>

    <div class="roadmap">
      {chapters.map((c, i) => (
        <section class="chapter" id={`ch-${i + 1}`}>
          <div class="chapter-head">
            <div class="chapter-title">
              <span class="chapter-symbol" aria-hidden="true">{c.symbol}</span>
              <div><strong>{c.name}</strong><small>{c.sub}</small></div>
            </div>
            <span class="chapter-count">{c.days.length} ngày</span>
          </div>
          <div class="day-grid">
            {c.days.map((d) => (
              <div class="day" data-day-row={`ef-${d.slug}`}
                   data-day-code={d.num}
                   data-day-title={`Ngày ${d.num} — ${d.short}`}
                   data-day-meta={`Bài tập: ${d.ex} · Dataset: ${d.ds}`}
                   data-day-href={`/${d.slug}/bai-hoc/`}>
                <a href={`/${d.slug}/bai-hoc/`}>
                  <span class="daynum" aria-hidden="true">{d.num}</span>
                  <span class="daytext">
                    <strong>Ngày {d.num} — {d.short}</strong>
                    <small>{d.ex} · {d.ds} · ~{d.mins + 40} phút</small>
                  </span>
                  <span class="daystatus" data-module-badge={`ef-${d.slug}`} data-empty="Chưa học">Chưa học</span>
                  <span class="day-arrow" aria-hidden="true">›</span>
                </a>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="lower">
      <div class="lower-card">
        <span class="tiny-label"><span class="dot"></span>KHO BÀI TẬP</span>
        <h3>60 bài tập nguồn — luyện theo kỹ năng</h3>
        <p>Toàn bộ bài tập gốc từ hai bộ đề P1 (43 câu) và P2 (15 câu) + 2 bài bổ sung. Tìm kiếm theo nội dung, lọc theo kỹ năng, mức độ và trạng thái làm bài.</p>
        <a href="/kho-bai-tap/">Mở Kho bài tập →</a>
      </div>
      <div class="lower-card">
        <span class="tiny-label"><span class="dot"></span>TÀI LIỆU &amp; MODULE THAM KHẢO</span>
        <h3>M01 — Tư duy nghiên cứu y khoa</h3>
        <p>Module tham khảo về ngôn ngữ thống kê và tư duy nghiên cứu — không nằm trong lộ trình 14 ngày bắt buộc. Cùng với hướng dẫn chuẩn bị dữ liệu &amp; dataset demo.</p>
        <a href="/m01/bai-hoc/">Đọc module M01 →</a>&nbsp;&nbsp;<a href="/du-lieu/">Dữ liệu thực hành →</a>
      </div>
    </div>

    <div class="notice">
      <span aria-hidden="true">💾</span>
      <div>
        <strong>Tiến độ lưu trên trình duyệt này.</strong> Dữ liệu của bạn nằm trong localStorage
        (<code>spss-mlp-progress-v1</code>) — không gửi đi đâu, có thể mất nếu xóa dữ liệu trình duyệt.
        Dùng Xuất/Nhập để chuyển giữa thiết bị:
        <button class="btn" type="button" style="padding:6px 10px;font-size:11px;margin:0 4px" onclick="slpExport()">Xuất tiến độ (JSON)</button>
        <label class="btn" style="padding:6px 10px;font-size:11px">Nhập tiến độ
          <input type="file" accept=".json" hidden onchange="slpImport(this.files[0])" />
        </label>
      </div>
    </div>

    <p class="footnote">
      SPSS Medical Learning Pack — lộ trình exercise-first 14 ngày · website build từ giáo trình Markdown canonical ·
      dataset nguồn (.sav, PDF đề) nằm trong <code>exercises/</code> trên máy của bạn, không phát hành qua web.
    </p>
  </main>

  <script src="/js/progress.js" defer></script>
</body>
</html>
