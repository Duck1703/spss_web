    "d04-means": {
      "step": "Bước 4–5",
      "title": "Means — bảng chỉ số theo nhóm (và 2 tầng nhóm)",
      "purpose": "Lấy Mean/SD của Tuoi theo giới (Câu 6) và theo giới × tiền sử HA gia đình (Câu 41) trong một bảng.",
      "where": "Split File → Analyze all cases đã tắt",
      "menuPath": ["Analyze", "Compare Means", "Means…", "Tuoi → Dependent", "GTinh → Independent", "OK"],
      "osNote": { "both": "Means không in Min/Max/Range — cần Min/Max thì tick trong Options… hoặc tính Range = Max−Min từ Descriptives." },
      "scenes": [
        {
          "kind": "dialog",
          "title": "Means",
          "dialog": {
            "title": "Means",
            "rows": [
              { "type": "lists", "left": ["ID", "GTinh", "DToc", "HVan", "HA.GDinh", "Chieucao", "Cannang"], "right": ["Tuoi"], "rightLabel": "Dependent List:", "hot": 1 },
              { "type": "lists", "left": [], "right": ["GTinh"], "rightLabel": "Independent List:", "hot": 2, "leftLabel": "Layer 1 of 1" },
              { "type": "note", "text": "Dependent = biến SỐ cần mô tả (Tuoi). Independent = biến NHÓM (GTinh). Nút Next thêm tầng nhóm thứ hai (HA.GDinh) cho bảng 2 chiều." }
            ],
            "buttons": [
              { "label": "Previous" }, { "label": "Next", "hot": 3 },
              { "label": "Options…" },
              { "label": "OK", "primary": true, "advance": true, "hot": 4 },
              { "label": "Reset" }, { "label": "Cancel" }
