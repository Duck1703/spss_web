              ]
            },
            {
              "title": "Report — Tuoi (GTinh × HA.GDinh, Câu 41)",
              "cols": ["GTinh", "HA.GDinh", "Mean", "N"],
              "rows": [
                [{ "label": "Nữ" }, { "label": "Có" }, { "label": "69,02" }, { "label": "185" }],
                [{ "label": "Nữ" }, { "label": "Không" }, { "label": "65,36" }, { "label": "191" }],
                [{ "label": "Nam" }, { "label": "Có" }, { "label": "67,15" }, { "label": "188" }],
                [{ "label": "Nam" }, { "label": "Không" }, { "label": "64,38" }, { "label": "56" }]
