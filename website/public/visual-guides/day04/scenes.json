          },
          "caption": "Tuoi → Dependent · GTinh → Independent → OK. (Next → HA.GDinh cho Câu 41.)",
          "callouts": [
            { "n": 1, "label": "Tuoi → Dependent List" },
            { "n": 2, "label": "GTinh → Independent List" },
            { "n": 3, "label": "Next — thêm tầng HA.GDinh (Câu 41)" },
            { "n": 4, "label": "OK" }
          ]
        },
        {
          "kind": "output",
          "title": "Output — Report (Means)",
          "outline": [
            { "t": "Means" },
            { "t": "Report", "ind": true }
          ],
          "tables": [
            {
              "title": "Report — Tuoi (theo GTinh, Câu 6)",
              "cols": ["GTinh", "Mean", "N", "Std. Deviation"],
              "rows": [
                [{ "label": "Nữ", "hot": 5 }, { "label": "67,16" }, { "label": "376" }, { "label": "11,060" }],
                [{ "label": "Nam", "hot": 6 }, { "label": "66,51" }, { "label": "244" }, { "label": "10,738" }],
