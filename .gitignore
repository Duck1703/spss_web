# ---- Workspace internals (temp/cache/logs) ----
.workspace/tmp/*
.workspace/cache/*
.workspace/logs/*
!.workspace/tmp/.gitkeep
!.workspace/cache/.gitkeep
!.workspace/logs/.gitkeep

# ---- Generated publishing outputs (rebuildable) ----
exports/*
!exports/README.md
!exports/.gitkeep

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# ---- Secrets & credentials (never commit) ----
*.key
*.pem
*.p12
.env
.env.*
secrets/
credentials*
*license*.lic

# ---- Local runtimes (if generators use Python/R later) ----
__pycache__/
*.pyc
.venv/
venv/
.Rhistory
.RData
.Rproj.user/

# ---- Temp ----
*.tmp
*.bak
~$*

# NOTE: .sav/.sps/.spv/.csv của học liệu là artifact quan trọng -> KHÔNG ignore.

# ---- Third-party exercise source materials (Task 13) ----
# PDF + .sav thuộc nguồn bên ngoài — chỉ dùng local, KHÔNG commit/publish (NEEDS_OWNER_VERIFICATION).
exercises/bai_1/
exercises/bai_2/

# ---- Task 13 analysis scratch (PDF text extract, stats) ----
.workspace/p1_text.txt
.workspace/p2_text.txt
.workspace/stats/
